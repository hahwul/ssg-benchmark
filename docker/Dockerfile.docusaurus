ARG NODE_IMAGE=node:22-bookworm-slim
FROM ${NODE_IMAGE}

LABEL maintainer="SSG Benchmark"
LABEL description="Docusaurus SSG Benchmark Environment"

# Docusaurus has no global CLI: `npx docusaurus build` resolves from the site's
# own node_modules, which sites/docusaurus/package.json pins exactly.

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /site

# Default command
CMD ["npx", "docusaurus", "build"]

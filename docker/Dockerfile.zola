ARG DEBIAN_IMAGE=debian:bookworm-slim
FROM ${DEBIAN_IMAGE}

LABEL maintainer="SSG Benchmark"
LABEL description="Zola SSG benchmark environment"

# Keep in sync with docker/versions.env.
ARG ZOLA_VERSION=0.22.1

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash \
        coreutils \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ARCH=$(dpkg --print-architecture) \
    && case "$ARCH" in \
        amd64) ZOLA_ARCH="x86_64-unknown-linux-gnu" ;; \
        arm64) ZOLA_ARCH="aarch64-unknown-linux-gnu" ;; \
        *) echo "Unsupported architecture: $ARCH" && exit 1 ;; \
    esac \
    && echo "Downloading Zola ${ZOLA_VERSION} for $ZOLA_ARCH" \
    && curl -fsSL "https://github.com/getzola/zola/releases/download/v${ZOLA_VERSION}/zola-v${ZOLA_VERSION}-${ZOLA_ARCH}.tar.gz" -o /tmp/zola.tar.gz \
    && tar -xzf /tmp/zola.tar.gz -C /usr/local/bin \
    && rm /tmp/zola.tar.gz \
    && chmod +x /usr/local/bin/zola \
    && zola --version

WORKDIR /site

CMD ["zola", "build"]

ARG RUST_IMAGE=rust:1.83-slim-bookworm
ARG DEBIAN_IMAGE=debian:bookworm-slim

FROM ${RUST_IMAGE} AS builder

# Keep in sync with docker/versions.env.
ARG BLADES_VERSION=0.6.0

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# `--locked` uses the Cargo.lock published with the release, so the whole
# dependency tree is pinned rather than just the top-level crate version.
RUN cargo install blades --version "${BLADES_VERSION}" --locked

FROM ${DEBIAN_IMAGE}

LABEL maintainer="SSG Benchmark"
LABEL description="Blades SSG benchmark environment"

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    && rm -rf /var/lib/apt/lists/*

# Copy blades binary from builder
COPY --from=builder /usr/local/cargo/bin/blades /usr/local/bin/blades

# Set working directory
WORKDIR /site

# Default command
CMD ["blades"]

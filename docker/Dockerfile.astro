ARG NODE_IMAGE=node:22-bookworm-slim
FROM ${NODE_IMAGE}

LABEL maintainer="SSG Benchmark"
LABEL description="Astro SSG Benchmark Environment"

# Keep in sync with docker/versions.env. Also pinned exactly in
# sites/astro/package.json, which is what `npx astro build` actually resolves.
ARG ASTRO_VERSION=5.18.2

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    && rm -rf /var/lib/apt/lists/*

# Install Astro globally
RUN npm install -g "astro@${ASTRO_VERSION}" \
    && npm cache clean --force

# Set working directory
WORKDIR /site

# Default command
CMD ["astro", "build"]

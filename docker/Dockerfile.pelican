ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}

LABEL maintainer="SSG Benchmark"
LABEL description="Pelican SSG Benchmark Environment"

# Keep in sync with docker/versions.env.
ARG PELICAN_VERSION=4.12.0

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    && rm -rf /var/lib/apt/lists/*

# Install Pelican with Markdown support. Pygments is what the blog/heavy
# scenarios use for build-time highlighting; pin it so highlighting cost does
# not drift between runs.
RUN pip install --no-cache-dir "pelican[markdown]==${PELICAN_VERSION}" \
    && pelican --version

# Set working directory
WORKDIR /site

# Default command
CMD ["pelican", "content", "-s", "pelicanconf.py"]

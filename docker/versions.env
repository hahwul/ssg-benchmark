# =============================================================================
# Pinned SSG toolchain versions — single source of truth
# =============================================================================
#
# Every Dockerfile takes these as build ARGs. Nothing in the benchmark may
# install a floating version: an unpinned toolchain means two runs a month
# apart silently compare different software, and whichever SSG happens to
# release in between looks like it "changed performance".
#
# Bump deliberately, in its own commit, and re-run the full suite afterwards —
# never mix a version bump with a methodology change.
#
# Consumed by:
#   scripts/benchmark.sh   (passes each as --build-arg)
#   Makefile               (docker-build)
#   .github/workflows/benchmark.yml
#
# Node-based SSGs additionally pin their npm dependency trees exactly (no
# caret ranges) in sites/*/package.json and scenarios/*/*/package.json.

# --- Runtime/base images (shared so libc and JS engine are not a variable) ---
NODE_IMAGE=node:22-bookworm-slim
DEBIAN_IMAGE=debian:bookworm-slim
RUBY_IMAGE=ruby:3.2-slim-bookworm
PYTHON_IMAGE=python:3.12-slim-bookworm

# --- Build-only toolchains (source-built SSGs) ---
RUST_IMAGE=rust:1.83-slim-bookworm
# hwaro's runner stage must stay on debian:13-slim to match this builder's glibc.
CRYSTAL_IMAGE=84codes/crystal:1.21.0-debian-13

# --- Compiled SSGs ---
# Hugo: pinned below 0.146.0 on purpose. 0.146 removed layouts/_default and
# renamed layouts/partials -> layouts/_partials; bumping past it requires
# migrating sites/hugo/layouts and scenarios/*/hugo/layouts first.
HUGO_VERSION=0.145.0
ZOLA_VERSION=0.22.1
BLADES_VERSION=0.6.0
HWARO_VERSION=v0.18.1
# The ref the optional `hwaro-main` variant builds from. It is deliberately a
# moving ref: that variant exists to answer "did hwaro's unreleased work change
# its numbers?", so pinning it would defeat it. Nothing else in the benchmark
# floats, and hwaro-main is never in the default SSG set — the published
# cross-SSG comparison only ever contains HWARO_VERSION above.
HWARO_MAIN_REF=main

# --- Interpreted / Node SSGs ---
JEKYLL_VERSION=4.4.1
# Bundler is deliberately held on the 2.x line: bundler 4 changes lockfile and
# resolution behaviour that jekyll 4.4 has not been validated against.
BUNDLER_VERSION=2.7.2
WEBRICK_VERSION=1.9.2
JEKYLL_FEED_VERSION=0.17.0
JEKYLL_PAGINATE_VERSION=1.1.0
JEKYLL_ARCHIVES_VERSION=2.3.0
PELICAN_VERSION=4.12.0
ELEVENTY_VERSION=3.1.6
ELEVENTY_HIGHLIGHT_VERSION=5.0.2
HEXO_CLI_VERSION=4.3.2
ASTRO_VERSION=5.18.2
GATSBY_CLI_VERSION=5.16.0
